Screen {
    background: $surface;
    align: center top;
    overflow-y: hidden;
}

Rule {
    width: 2;
    color: $panel;
}

#display {
    width: 60%;
    height: auto;
    border: round $primary;
    padding: 2 8;
    content-align: center middle;
    text-align: center;
    overflow-y: hidden;
}

#location-input {
    height: auto;
    width: 100%;
    dock: bottom;
}

#metric-container {
    height: auto;
    width: 100%;
    dock: top;
    margin-top: 1;
}

#location-card {
    border: round $secondary;
    text-align: center;
}

#local-clock {
    border: round $secondary;
    text-align: center;
}

#license {
    text-align: center;
    overflow-x: auto;
    height: auto;
    width: 1fr;
    margin: 0 1;
}

.stack {
    overflow-y: auto;
    scrollbar-size: 0 0;
    scrollbar-visibility: hidden;
}

.card {
    content-align: center middle;
    align-horizontal: center;
    align-vertical: top;
}

.details {
    width: 1fr;
    height: auto;
    margin: 0 0;
}

.metric {
    width: 1fr;
    height: auto;
    border: round $primary;
    margin: 0 1;
}

.hide {
    display: none;
}

.start {
    display: block;
}