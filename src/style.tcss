Screen {
    background: $surface;
    align: center top;
}

ContentSwitcher {
    column-span: 3;
    row-span: 2;
    width: 100%;
    height: 100%;
}

#display {
    width: 60%;
    height: auto;
    border: round $primary;
    padding: 2 8;
    content-align: center middle;
    text-align: center;
}

#city-input {
    height: auto;
    width: 100%;
    dock: bottom;
}

#metric-container {
    height: auto;
    width: 100%;
    dock: top;
    margin-top: 1;
}

#location-card {
    width: 1fr;
    height: auto;
    border: round $secondary;
    margin: 0 0;
    content-align: center middle;
    align-vertical: top;
    /*align: center top;*/
}

.details {
    
}

.metric {
    width: 1fr;
    height: auto;
    border: round $primary;
    margin: 0 1;
    content-align: center middle;
    align-vertical: top;
    /*align: center top;*/
}

.hide {
    display: none;
}

.start {
    display: block;
}